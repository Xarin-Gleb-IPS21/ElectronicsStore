@model ElectronicsStore.Models.ImportResult

@{
    ViewData["Title"] = "Результат импорта";
}

<h2>Результат импорта</h2>

<div style="display: flex; gap: 20px; margin-bottom: 20px;">
    <div style="border: 1px solid #ccc; padding: 15px; background-color: #e3f2fd; flex: 1;">
        <h4>Всего строк</h4>
        <p style="font-size: 24px; font-weight: bold;">@Model.TotalRows</p>
    </div>
    <div style="border: 1px solid #ccc; padding: 15px; background-color: #e8f5e9; flex: 1;">
        <h4>Успешно импортировано</h4>
        <p style="font-size: 24px; font-weight: bold; color: green;">@Model.ImportedCount</p>
    </div>
    <div style="border: 1px solid #ccc; padding: 15px; background-color: #ffebee; flex: 1;">
        <h4>Ошибки</h4>
        <p style="font-size: 24px; font-weight: bold; color: red;">@Model.Errors.Count</p>
    </div>
</div>

@if (Model.Errors.Any())
{
    <h4>Список ошибок:</h4>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
        <thead>
            <tr style="background-color: #333; color: white;">
                <th style="padding: 10px; text-align: left; width: 100px;">Строка</th>
                <th style="padding: 10px; text-align: left;">Описание ошибки</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var error in Model.Errors)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 10px;">@error.LineNumber</td>
                    <td style="padding: 10px; color: red;">@error.Message</td>
                </tr>
            }
        </tbody>
    </table>
}

<div style="margin-top: 20px;">
    <a asp-action="Index" style="padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;">Перейти к списку товаров</a>
    <a asp-action="Import" style="margin-left: 15px; padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 5px;">Загрузить еще файл</a>
</div>